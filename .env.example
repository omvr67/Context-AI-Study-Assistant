# Copy this file to .env and replace the placeholder with your own Groq API key.
GROQ_API_KEY="your_groq_api_key_here"

# --- Everything below is optional. Unset = today's local-dev behavior. ---

# Groq model to use. Leave unset to keep the default (openai/gpt-oss-120b).
# GROQ_MODEL="openai/gpt-oss-120b"

# Comma-separated list of origins allowed to call the API. Leave unset for
# "*" (fine for local dev). Once the demo is running behind a tunnel/same-
# origin frontend, set this to the real public URL, e.g.:
# ALLOWED_ORIGINS="https://my-tunnel.trycloudflare.com"

# Turns on the public-demo protections added this round (shared-course
# write protection, visitor-data expiry, etc.) as each lands. Leave unset
# (false) for local development.
# DEMO_MODE="true"

# Hidden token that unlocks shared-course add/delete while DEMO_MODE is on.
# Pick any long random string; send it as the X-Admin-Token header.
# ADMIN_TOKEN="choose-a-long-random-string"

# Per-visitor request limits (course/notebook uploads, chat, flashcards,
# quizzes). The per-minute one absorbs ordinary bursts; the per-day one
# protects your Groq quota over a long demo day. Leave unset for the
# defaults (15/minute, 300/day).
# RATE_LIMIT_PER_MINUTE="15"
# RATE_LIMIT_PER_DAY="300"

# Input/resource caps. Leave unset for the defaults shown here.
# MAX_MESSAGE_LENGTH="4000"       # characters, per chat message
# HISTORY_WINDOW_TURNS="20"       # most recent turns kept in a session's prompt
# NOTEBOOK_MAX_DOCS="5"           # PDFs per device in the private notebook
# NOTEBOOK_MAX_MB="50"            # total extracted-text size per device

# Hours of inactivity before a chat session (and its quiz history) or a
# notebook upload is auto-deleted by a background sweep. Set to "0" to
# disable the sweep entirely. Leave unset for the default (24).
# DATA_TTL_HOURS="24"

# Resilience. Leave unset for the defaults shown here.
# LLM_CALL_TIMEOUT_SECONDS="30"   # per Groq HTTP request
# MAX_CONCURRENT_LLM_CALLS="5"    # across every visitor combined
# LLM_QUEUE_WAIT_SECONDS="10"     # how long a call waits for a free slot

# Log verbosity (DEBUG, INFO, WARNING, ERROR). Leave unset for INFO.
# LOG_LEVEL="INFO"
